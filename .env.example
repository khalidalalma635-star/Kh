# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/khalidai"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-secret-to-a-secure-random-string"
JWT_SECRET="change-this-jwt-secret-to-a-secure-random-string"

# AI Provider
AI_PROVIDER="openai"
OPENAI_API_KEY=""
CLAUDE_API_KEY=""
GEMINI_API_KEY=""

# App settings
NODE_ENV="development"
PORT="3000"
LOG_LEVEL="info"
RATE_LIMIT_REQUESTS="100"
RATE_LIMIT_WINDOW="900000"
MAX_FILE_SIZE="10485760"
ALLOWED_FILE_TYPES="pdf,txt,md,json,csv"

# Security
BCRYPT_ROUNDS="10"
