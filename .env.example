# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/khalidai"

# Next Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-secure-string-min-32-chars"

# JWT
JWT_SECRET="change-this-to-a-random-secure-string-min-32-chars"

# AI Provider
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-..."
CLAUDE_API_KEY="sk-ant-..."
GEMINI_API_KEY="AIza..."

# App Config
NODE_ENV="development"
PORT="3000"
LOG_LEVEL="info"

# Security
BCRYPT_ROUNDS="10"

# Rate Limiting
RATE_LIMIT_REQUESTS="100"
RATE_LIMIT_WINDOW="900000"

# File Upload
MAX_FILE_SIZE="10485760"
ALLOWED_FILE_TYPES="pdf,txt,md,json,csv"
